+func rgbaToPNG(path string, pixels []byte, width, height int) error {
+	img := image.NewRGBA(image.Rect(0, 0, width, height))
+	copy(img.Pix, pixels)
+
+	f, err := os.Create(path)
+	if err != nil {
+		return fmt.Errorf("failed to open temp png: %w", err)
+	}
+	defer f.Close()
+
+	if err := png.Encode(f, img); err != nil {
+		return fmt.Errorf("encode png: %w", err)
+	}
+	return nil
+}
