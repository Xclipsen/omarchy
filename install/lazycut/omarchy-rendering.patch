+	"strings"
+
@@ -34,5 +36,14 @@ func (p *Preview) Render(width, height int) string {
-	return lipgloss.NewStyle().
-		Width(width).
-		Height(height).
-		Align(lipgloss.Center, lipgloss.Center).
-		Render(frame)
+	return fitFrame(frame, height)
+}
+
+func fitFrame(frame string, height int) string {
+	lines := strings.Split(frame, "\n")
+
+	if len(lines) > height {
+		lines = lines[:height]
+	}
+	for len(lines) < height {
+		lines = append(lines, "")
+	}
+
+	return strings.Join(lines, "\n")
