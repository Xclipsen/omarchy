#!/bin/bash

# omarchy:summary=Install encrypted Lab Backup from its private GitHub release
# omarchy:requires-sudo=true

set -euo pipefail

gh auth status >/dev/null || {
  echo "GitHub CLI must be authenticated for the private Xclipsen/lab-backup repository." >&2
  exit 1
}

omarchy-pkg-github-release-add \
  Xclipsen/lab-backup \
  v1.0.0 \
  lab-backup-1.0.0-1-any.pkg.tar.zst \
  56f7a88e4ba68a1031dbe50e3a3e37eef3a16efdf2282319e4d235be23c77ac1 \
  lab-backup

/usr/bin/lab-backup-setup
